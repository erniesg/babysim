# BabySim demo env. Copy to .env and fill values that you actually need.
# All AI-backed features are optional; the demo runs without them.

# Gemini (for baby SFX generation script + future GM)
# Read by gemini-tts script and any future Gemini calls.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI (optional GM/debrief LLM, future)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_REALTIME_MODEL=gpt-realtime

# ElevenLabs (proven path for newborn-cry SFX; used by audio gen script as fallback)
ELEVENLABS_API_KEY=

# Browser feature flags — all model-backed paths fall back when unavailable
VITE_ENABLE_GM_AGENT=1
VITE_ENABLE_OFFICER_AGENT=1
VITE_ENABLE_BABY_AGENT=1
VITE_PARTNER_LIVE_TEXT=0
VITE_REALTIME_PARTNER_PROVIDER=openai
VITE_ENABLE_REALTIME_PARTNER=1

# Default: tune for ~2-3 minute demo run
VITE_REAL_SECONDS_PER_GAME_HOUR=4
